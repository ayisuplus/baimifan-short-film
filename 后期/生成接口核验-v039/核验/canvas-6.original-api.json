  },
  "9": {
    "inputs": {
      "prompt": "Replace only the dark teal top with a matte burgundy crew-neck sweater. Match the original fabric folds, shadows and lighting. Keep the man's face, hairstyle, pose, body shape, framing and plain background unchanged.",
      "negative_prompt": "",
      "resolution": 992,
      "clip": [
        "6",
        0
      ],
      "vae": [
        "7",
        0
      ],
      "images.image_1": [
        "3",
        0
      ]
