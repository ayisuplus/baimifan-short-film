{
  "1": {
    "inputs": {
      "image": "qwen21-official-portrait.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "主图｜在这里换自己的图"
    }
  },
  "2": {
    "inputs": {
      "left": 0,
      "top": 0,
      "right": 0,
      "bottom": 0,
      "feathering": 80,
      "image": [
        "1",
        0
      ]
    },
    "class_type": "ImagePadForOutpaint",
    "_meta": {
      "title": "扩画布｜按需填写四边像素"
    }
  },
  "3": {
    "inputs": {
      "switch": [
        "23",
        0
      ],
      "on_false": [
        "1",
        0
