    "class_type": "GrowMask",
    "_meta": {
      "title": "局部区域｜扩大蒙版12像素"
    }
  },
  "13": {
    "inputs": {
      "mask": [
        "12",
        0
      ]
    },
    "class_type": "MaskToImage",
    "_meta": {
      "title": "蒙版转图像"
    }
  },
  "14": {
    "inputs": {
      "blur_radius": 9,
      "sigma": 3.0,
      "image": [
        "13",
        0
      ]
    },
    "class_type": "ImageBlur",
    "_meta": {
      "title": "局部边缘柔化"
    }
  },
  "15": {
    "inputs": {
      "channel": "red",
      "image": [
        "14",
        0
      ]
    },
    "class_type": "ImageToMask",
