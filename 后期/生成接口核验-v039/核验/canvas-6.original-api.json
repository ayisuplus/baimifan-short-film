  "16": {
    "inputs": {
      "x": 0,
      "y": 0,
      "resize_source": true,
      "destination": [
        "1",
        0
      ],
      "source": [
        "11",
        0
      ],
      "mask": [
        "15",
        0
      ]
    },
    "class_type": "ImageCompositeMasked",
    "_meta": {
      "title": "局部保真｜蒙版外用原图"
    }
  },
  "17": {
    "inputs": {
      "switch": false,
      "on_false": [
        "11",
        0
      ],
      "on_true": [
        "16",
        0
      ]
    },
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "局部保真开关｜默认关闭"
    }
  },
  "26": {
    "inputs": {
      "switch": [
        "23",
        0
      ],
      "on_false": [
        "17",
        0
      ],
      "on_true": [
        "25",
        0
      ]
    },
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "扩图还原｜随扩图模式切换"
