    "_meta": {
      "title": "编辑指令｜第二张图可选"
    }
  },
  "10": {
    "inputs": {
      "seed": 42,
      "steps": 40,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": [
        "8",
        0
      ],
      "positive": [
        "9",
        0
      ],
      "negative": [
        "9",
        1
      ],
      "latent_image": [
        "9",
        2
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "采样｜40步 / CFG 1"
    }
  },
  "11": {
    "inputs": {
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8,
      "samples": [
        "10",
        0
      ],
      "vae": [
        "7",
        0
      ]
    },
    "class_type": "VAEDecodeTiled",
    "_meta": {
      "title": "分块解码｜保留透明通道"
